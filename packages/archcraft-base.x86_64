sddm
mesa
vulkan-intel
vulkan-radeon
intel-media-driver
polkit
dbus-broker-units
xdg-user-dirs
xdg-utils
sof-firmware
wireless-regdb
wpa_supplicant
iwd
qemu-guest-agent
