mkinitcpio-archiso
syslinux
systemd-resolvconf
squashfs-tools
edk2-shell
memtest86+
memtest86+-efi
mtools

# Archcraft integration retained by the derivative
archcraft-mirrorlist
archcraft-hooks
archcraft-hooks-extra

