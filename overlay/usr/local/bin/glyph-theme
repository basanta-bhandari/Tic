#!/usr/bin/env bash
set -euo pipefail

readonly THEME_DB="${GLYPH_THEME_DB:-/etc/glyph/themes.tsv}"
readonly CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/kitty"
readonly THEME_FILE="$CONFIG_DIR/current-theme.conf"

[[ -r "$THEME_DB" ]] || { printf 'glyph-theme: missing %s\n' "$THEME_DB" >&2; exit 1; }

theme="${1:-}"
if [[ -z "$theme" ]]; then
    if command -v fzf >/dev/null 2>&1; then
        theme="$(awk -F '\t' '!/^#/ {print $1 "\t" $2}' "$THEME_DB" |
            fzf --delimiter=$'\t' --with-nth=1,2 --prompt='Zenith theme> ' |
            cut -f1)" || exit 0
    else
        printf 'Available themes:\n'
        awk -F '\t' '!/^#/ {printf "  %-10s %s\n", $1, $2}' "$THEME_DB"
        exit 0
    fi
fi

row="$(awk -F '\t' -v wanted="$theme" 'tolower($1) == tolower(wanted) {print; exit}' "$THEME_DB")"
[[ -n "$row" ]] || { printf 'glyph-theme: unknown theme: %s\n' "$theme" >&2; exit 1; }
IFS=$'\t' read -r theme label foreground background accent selection gradient_start gradient_end <<<"$row"

install -d -m 0755 "$CONFIG_DIR"
cat >"$THEME_FILE" <<EOF
# Generated by glyph-theme. Edit /etc/glyph/themes.tsv to add palettes.
foreground $foreground
background $background
selection_foreground $background
selection_background $selection
cursor $accent
cursor_text_color $background
active_border_color $accent
inactive_border_color $selection
active_tab_foreground $background
active_tab_background $accent
inactive_tab_foreground $foreground
inactive_tab_background $selection
color0 $background
color1 #ff5c8a
color2 #7bd88f
color3 #f4c95d
color4 #55aaff
color5 #c678dd
color6 #55d6be
color7 $foreground
color8 $selection
color9 #ff7a9f
color10 #96e6a5
color11 #ffe08a
color12 #7dbdff
color13 #d99aee
color14 #7be7d2
color15 #f3f5f8
EOF

printf '%s\n' "$theme" >"${XDG_CONFIG_HOME:-$HOME/.config}/glyph-theme"
if [[ -n ${KITTY_LISTEN_ON:-} ]] && command -v kitty >/dev/null 2>&1; then
    kitty @ set-colors --all "$THEME_FILE" >/dev/null 2>&1 || true
fi
glyph-wallpaper --refresh "$gradient_start" "$gradient_end" >/dev/null 2>&1 || true
printf 'Applied Zenith theme: %s\n' "$label"
