#!/usr/bin/env bash
set -uo pipefail

usage() {
    cat <<'EOF'
Usage: glyph-open PATH_OR_URL

Open a directory, document, image, media file, archive, or URL using a
text-oriented Zenith application. Executables are never run automatically.
EOF
}

if [[ ${1:-} == -h || ${1:-} == --help ]]; then
    usage
    exit 0
fi
[[ $# -eq 1 ]] || { usage >&2; exit 2; }

target="$1"
case "$target" in
    http://*|https://*) exec w3m "$target" ;;
esac

[[ -e "$target" ]] || { printf 'glyph-open: not found: %s\n' "$target" >&2; exit 1; }
target="$(realpath -- "$target")"

if [[ -d "$target" ]]; then
    exec yazi "$target"
fi

mime="$(file --brief --mime-type -- "$target")"
name="${target##*/}"
extension="${name##*.}"
extension="${extension,,}"
editor="${EDITOR:-}"
if [[ -z "$editor" ]]; then
    if command -v nvim >/dev/null 2>&1; then
        editor=nvim
    else
        editor=nano
    fi
fi

case "$extension" in
    md|markdown|mdown) exec glow -p "$target" ;;
    csv|tsv|xlsx|xls|ods|parquet|sqlite|db) exec vd "$target" ;;
    json|jsonl|geojson) exec bash -c 'jq . -- "$1" | less -R' _ "$target" ;;
    pdf) exec bash -c 'pdftotext -layout "$1" - | less -R' _ "$target" ;;
esac

case "$mime" in
    text/html|application/xhtml+xml) exec w3m "$target" ;;
    text/*|application/xml|application/x-shellscript) exec "$editor" "$target" ;;
    image/*)
        if [[ -n ${KITTY_WINDOW_ID:-} ]] && command -v kitty >/dev/null 2>&1; then
            exec kitty +kitten icat --transfer-mode=stream -- "$target"
        fi
        exec chafa --format symbols --colors full -- "$target"
        ;;
    audio/*) exec mpv --no-video -- "$target" ;;
    video/*)
        if [[ -n ${WAYLAND_DISPLAY:-} ]] && command -v vlc >/dev/null 2>&1; then
            exec vlc -- "$target"
        fi
        exec mpv --vo=tct --really-quiet -- "$target"
        ;;
    application/pdf) exec bash -c 'pdftotext -layout "$1" - | less -R' _ "$target" ;;
    application/zip|application/x-7z-compressed|application/x-tar|application/gzip|application/x-bzip2|application/zstd)
        exec 7z l -- "$target"
        ;;
    application/vnd.openxmlformats-officedocument.*|application/vnd.oasis.opendocument.*)
        printf 'Zenith can list this compound document but cannot render its graphical layout.\n\n'
        exec 7z l -- "$target"
        ;;
esac

if [[ -x "$target" ]]; then
    printf 'glyph-open: refusing to execute %s automatically\n' "$target" >&2
    printf 'Run it explicitly from Fish if you trust it.\n' >&2
    exit 126
fi

exec less -R -- "$target"
