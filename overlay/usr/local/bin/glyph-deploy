#!/usr/bin/env bash
set -euo pipefail

readonly PAYLOAD="/usr/local/share/glyph"
skip_packages=0

usage() {
    cat <<'EOF'
Usage: glyph-deploy [--skip-packages] TARGET

Install Zenith's package set, root overlay, and system defaults into a mounted
Arch Linux root filesystem. TARGET must be a mountpoint and may not be `/`.

Options:
  --skip-packages   Copy configuration without running pacstrap
  -h, --help        Show this help
EOF
}

die() {
    printf 'glyph-deploy: %s\n' "$*" >&2
    exit 1
}

args=()
while (($#)); do
    case "$1" in
        --skip-packages) skip_packages=1; shift ;;
        -h|--help) usage; exit 0 ;;
        --) shift; args+=("$@"); break ;;
        -*) die "unknown option: $1" ;;
        *) args+=("$1"); shift ;;
    esac
done

((${#args[@]} == 1)) || { usage >&2; exit 2; }
((EUID == 0)) || die "must run as root"
[[ -d "$PAYLOAD/rootfs" ]] || die "installation payload is missing"
[[ -r "$PAYLOAD/packages.x86_64" ]] || die "package manifest is missing"
command -v arch-chroot >/dev/null 2>&1 || die "arch-chroot is missing"

target="$(realpath -e -- "${args[0]}")"
[[ "$target" != / ]] || die "refusing to deploy over the running root filesystem"
mountpoint -q "$target" || die "target is not a mountpoint: $target"
[[ -r "$target/etc/pacman.conf" && -x "$target/usr/bin/pacman" ]] || \
    die "target does not look like an installed Arch root"

printf 'Deploying Zenith OS to %s\n' "$target"
if ((skip_packages == 0)); then
    mapfile -t packages < <(awk '!/^[[:space:]]*(#|$)/ {print $1}' "$PAYLOAD/packages.x86_64")
    ((${#packages[@]})) || die "package manifest is empty"

    # Maintained forks travel inside the ISO so installation never depends on
    # a temporary build-machine file:// repository. Keep them in Pacman's
    # normal cache, install them first, then exclude their names from the
    # repository transaction.
    shopt -s nullglob
    custom_packages=("$PAYLOAD/packages"/*.pkg.tar.zst)
    shopt -u nullglob
    if ((${#custom_packages[@]})); then
        install -d -m 0755 "$target/var/cache/pacman/pkg"
        install -m 0644 "${custom_packages[@]}" "$target/var/cache/pacman/pkg/"
        custom_chroot_paths=()
        for package_path in "${custom_packages[@]}"; do
            custom_chroot_paths+=("/var/cache/pacman/pkg/${package_path##*/}")
        done
        arch-chroot "$target" pacman -U --needed --noconfirm -- "${custom_chroot_paths[@]}"
        filtered_packages=()
        for package_name in "${packages[@]}"; do
            [[ "$package_name" == kage-shell ]] || filtered_packages+=("$package_name")
        done
        packages=("${filtered_packages[@]}")
    fi

    ((${#packages[@]})) && \
        arch-chroot "$target" pacman -Syu --needed --noconfirm -- "${packages[@]}"
fi

cp -a -- "$PAYLOAD/rootfs/." "$target/"
chmod 0755 "$target"/usr/local/bin/glyph* "$target/usr/local/bin/arca" \
    "$target/usr/local/bin/zenith" "$target/usr/local/bin/imperium" \
    "$target/usr/local/lib/glyph/"*.sh

arch-chroot "$target" /usr/local/lib/glyph/post-install.sh
printf '\nZenith deployment complete.\n'
