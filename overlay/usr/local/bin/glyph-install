#!/usr/bin/env bash
set -uo pipefail

# shellcheck source=/usr/local/lib/glyph/ui.sh
source /usr/local/lib/glyph/ui.sh

usage() {
    cat <<'EOF'
Usage: glyph-install

Run the official Archinstall guided installer, then deploy the Glyph package
set and text desktop into its mounted target.
EOF
}

case "${1:-}" in
    -h|--help) usage; exit 0 ;;
    "") ;;
    *) usage >&2; exit 2 ;;
esac

((EUID == 0)) || { printf 'glyph-install must run as root.\n' >&2; exit 1; }
command -v archinstall >/dev/null 2>&1 || { printf 'archinstall is not installed.\n' >&2; exit 1; }

glyph_confirm "Install Glyph Linux" \
    "Installation can repartition and erase disks.\n\nThe official Archinstall interface will handle disks, encryption, locale, bootloader, users, and base installation. Read every summary before confirming.\n\nContinue?" || exit 0

clear
archinstall
install_status=$?
if ((install_status != 0)); then
    printf '\nArchinstall exited with status %d; Glyph deployment was not attempted.\n' "$install_status" >&2
    exit "$install_status"
fi

target=""
for candidate in /mnt /mnt/archinstall; do
    if mountpoint -q "$candidate" && [[ -x "$candidate/usr/bin/pacman" ]]; then
        target="$candidate"
        break
    fi
done

if [[ -z "$target" ]]; then
    target="$(glyph_dialog --title "Installed system" --inputbox \
        "Archinstall completed, but its target was not detected. Enter the mounted target root, or Cancel to deploy later with glyph-deploy." 12 76 /mnt)" || {
            printf 'Run glyph-deploy TARGET after mounting the new Arch system.\n'
            exit 0
        }
fi

glyph-deploy "$target"
deploy_status=$?
if ((deploy_status == 0)); then
    glyph_message "Installation complete" \
        "Glyph Linux is installed. Remove the installation medium and reboot when ready."
fi
exit "$deploy_status"
