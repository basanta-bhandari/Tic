post_install() {
  grep -qe '^/usr/bin/fish$' etc/shells || echo '/usr/bin/fish' >> etc/shells
  grep -qe '^/bin/fish$' etc/shells || echo '/bin/fish' >> etc/shells
  grep -qe '^/usr/bin/kage$' etc/shells || echo '/usr/bin/kage' >> etc/shells
  grep -qe '^/bin/kage$' etc/shells || echo '/bin/kage' >> etc/shells
}

post_upgrade() {
  post_install
}

pre_remove() {
  sed -ri -e '\|^/usr/bin/fish$|d' -e '\|^/bin/fish$|d' \
    -e '\|^/usr/bin/kage$|d' -e '\|^/bin/kage$|d' etc/shells
}
